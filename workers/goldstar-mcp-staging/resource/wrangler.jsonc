{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "goldstar-mcp-resource-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "services": [
    {
      "binding": "AUTH_SERVER",
      "service": "goldstar-mcp-auth-staging"
    }
  ],
  "vars": {
    "MCP_RESOURCE": "https://goldstar-mcp-resource-staging.goldstar-al-manager.workers.dev/mcp",
    "OAUTH_ISSUER": "https://goldstar-mcp-auth-staging.goldstar-al-manager.workers.dev"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}